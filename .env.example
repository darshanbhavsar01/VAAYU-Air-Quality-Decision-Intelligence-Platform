# VAAYU secrets & config — copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------

# data.gov.in API key (register free at https://data.gov.in → Sign In → "My Account" → API key)
# Grants access to CPCB CAAQMS real-time resource.
DATA_GOV_IN_API_KEY=

# OpenAQ v3 API key (register free at https://explore.openaq.org → account → API keys)
# v3 requires this in the X-API-Key header. OPTIONAL — email verification has been
# flaky; WAQI below is the primary secondary source until/unless this arrives.
OPENAQ_API_KEY=

# WAQI (aqicn.org) API token — instant, no email verification wait.
# Get it at https://aqicn.org/data-platform/token/ (enter email, token shown immediately).
# Used for cross-validating CPCB readings and station-density checks per city.
WAQI_API_TOKEN=

# Open-Meteo needs no key.

# --- GCP (used from Phase 1 onward) ---
GCP_PROJECT_ID=
BQ_DATASET=vaayu
GEMINI_API_KEY=            # AI Studio key (generativelanguage.googleapis.com), NOT Vertex

# City targeting is now config-driven via config/cities.yaml (nationwide, multi-city).
# CITY_NAME/CITY_STATE below are legacy fallbacks for not-yet-migrated scripts only.
CITY_NAME=Bengaluru
CITY_STATE=Karnataka
